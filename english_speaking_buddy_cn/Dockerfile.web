# 方案 B：仅构建「网页 + /api/token」镜像；LiveKit Agent 在 LiveKit Cloud 另行部署
FROM python:3.12-slim
WORKDIR /app

COPY requirements-web.txt .
RUN pip install --no-cache-dir -r requirements-web.txt

COPY realtime_server.py .
COPY realtime_web ./realtime_web

ENV PYTHONUNBUFFERED=1
EXPOSE 8030

# Railway 等平台会注入 PORT；本地默认 8030
CMD ["sh", "-c", "exec uvicorn realtime_server:app --host 0.0.0.0 --port ${PORT:-8030}"]
