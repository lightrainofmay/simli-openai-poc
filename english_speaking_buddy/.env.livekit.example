# =============================================================================
# 复制为 .env.livekit 后，按块去对应网站申请 Key（需要「充值/套餐」的见各站定价页）
# =============================================================================
# 1) LiveKit Cloud   https://cloud.livekit.io
# 2) Simli           https://app.simli.com
# 3) Deepgram        https://console.deepgram.com
# 4) Cartesia        https://cartesia.ai
# 5) OpenAI          https://platform.openai.com/api-keys
#    或 OpenRouter   https://openrouter.ai/keys
# =============================================================================

# --- 1. LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=english-speaking-buddy-cloud
# 正式页是否显示「高级连接」折叠区；评委/学生端可设 0 隐藏 LiveKit 等技术项
WEB_SHOW_ADVANCED=1

# --- 2. Simli ---
SIMLI_API_KEY=your_simli_api_key
SIMLI_FACE_ID=your_simli_face_uuid
# 可选：Trinity 情绪 UUID（默认与插件一致）。动作观感不佳可在 https://docs.simli.com/emotions 换其他情绪试
# SIMLI_EMOTION_ID=92f24a0c-f046-45df-8df0-af7449c04571

# --- 3. Deepgram（STT）---
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-3
# 流式识别需固定语言；英语口语场景推荐 en-US
DEEPGRAM_LANGUAGE=en-US
# stt=用 Deepgram 端点提交用户话轮（推荐）；multilingual=内置多语 EOU 模型；vad=纯静音端点
TURN_DETECTION=stt

# --- 4. Cartesia（TTS）---
CARTESIA_API_KEY=your_cartesia_api_key
# 在 https://play.cartesia.ai/ 选择英文音色后复制 Voice ID
CARTESIA_VOICE_ID=6eb8965c-e295-47bd-a9e4-3eeebb3abcff
CARTESIA_MODEL=sonic-3
CARTESIA_LANGUAGE=en
# 与 Simli 流式输入 16kHz 一致，减少重采样；需要更高音质可改 24000
CARTESIA_SAMPLE_RATE=16000
# sonic 下 word_timestamps 建议先设 0，稳定后再按需打开
CARTESIA_WORD_TIMESTAMPS=0
# 首句前预热 TTS WebSocket（秒）；仅拖慢「进房后第一次说话」前的一小段，设 0 可省掉
CARTESIA_PREWARM_SEC=0.12
# blingfire 分句最小长度；略小（如 14–16）首包出音更快，略大更顺
CARTESIA_MIN_SENTENCE_LEN=16

# --- 5. 大模型 ---
# 若日志出现 401 invalid_api_key：检查密钥是否有效、是否多复制了空格/换行；或改用 OpenRouter（USE_OPENROUTER_LLM=1 + OPENROUTER_API_KEY）
OPENAI_API_KEY=your_openai_api_key
OPENAI_LLM_MODEL=gpt-4o-mini
USE_OPENROUTER_LLM=0

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
# 网页对话区：英文气泡下显示中文释义（/api/translate，与上一行共用密钥）
# OPENROUTER_TRANSLATE_MODEL=openai/gpt-4o-mini

# --- 6. 模式 ---
USE_TTS_ONLY=0
# STT 尾字修正时会取消并重启合成，听感像「顿一下」；数字人说到一半被切可试 0（首包略晚）
PREEMPTIVE_GENERATION=1
DISABLE_BVC=0

# --- 6b. 话轮 / 打断（数字人说到一半停、或误打断）---
# 用户停说后，再等约这么多秒才把话轮交给模型（略小首包更快，太小易抢话）
ENDPOINTING_MIN_DELAY_SEC=0.42
ENDPOINTING_MAX_DELAY_SEC=3.0
# 用户持续说话至少这么久才视为「打断数字人」；略大可减少环境噪声误打断
INTERRUPTION_MIN_DURATION_SEC=0.85
# 误判打断后静音多久视为假打断（由 runtime 续播；勿在代码里再 generate_reply）
FALSE_INTERRUPTION_TIMEOUT_SEC=2.5
INTERRUPTION_ENABLED=1
RESUME_FALSE_INTERRUPTION=1

# --- 7. VAD（与 Silero 插件一致；过小易抖、误切话轮）---
VAD_MIN_SPEECH_SEC=0.10
VAD_MIN_SILENCE_SEC=0.35
VAD_ACTIVATION_THRESHOLD=0.50
